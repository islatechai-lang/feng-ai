# ==============================================================================
# FengShui Room Analyzer - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Gateway / UnoRouter Configuration
# ------------------------------------------------------------------------------
# UnoRouter endpoint
UNOROUTER_BASE_URL="https://api.unorouter.com/v1"
UNOROUTER_API_KEY="your-unorouter-api-key"

# Reasoning and Classical Rules model (Section 4 mandated: qwen3.6-35b-a3b:free)
REASONING_MODEL="qwen3.6-35b-a3b:free"

# Vision spatial parsing model (multimodal Qwen 3.6 MoE, or gpt-4o-mini / claude-3-haiku)
VISION_MODEL="qwen3.6-35b-a3b:free"

# Image regeneration / edit model (Section 4 mandated: gpt-image-2.5-sunburst)
IMAGE_MODEL="gpt-image-2.5-sunburst"

# ------------------------------------------------------------------------------
# 2. Supabase (Database, Auth, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 3. Payments (Stripe)
# ------------------------------------------------------------------------------
# If omitted, application runs in seamless instant demo unlock mode for testing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------------------------
# 4. App & Telemetry
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_POSTHOG_KEY=""
