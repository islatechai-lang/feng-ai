# Environment Variables Example for FengShui AI Mobile App

# Google Gemini API (Recommended: Powers Multimodal Vision, Reasoning, & Inpainting)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Supabase (Auth, Persistence & Analytics)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# UnoRouter / OpenRouter (Optional Secondary Fallback)
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
